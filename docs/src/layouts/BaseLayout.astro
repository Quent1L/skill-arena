---
import Nav from '../components/Nav.astro'
import Icon from '../components/Icon.astro'
import '../styles/global.css'

interface Props {
  title: string
  description?: string
}
const { title, description = 'Skol Arena — tournament management, done right.' } = Astro.props
const repoUrl = 'https://github.com/Quent1L/skol-arena'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <!-- Raster, not the SVG: most crawlers ignore an SVG og:image outright. -->
    <meta property="og:image" content="/icon-512.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Exo+2:wght@600;700;800;900&family=Rajdhani:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title} · Skol Arena</title>
  </head>
  <body class="min-h-screen text-slate-100">
    <Nav />
    <main data-pagefind-body>
      <slot />
    </main>
    <footer class="border-t border-white/10 bg-black/20">
      <div
        class="mx-auto flex max-w-6xl flex-col items-center gap-4 px-6 py-10 text-sm text-slate-400 sm:flex-row sm:justify-between"
      >
        <p>Skol Arena — Skill Or Luck? Open source, self-hostable.</p>
        <div class="flex items-center gap-5">
          <a href="/docs" class="transition-colors hover:text-brand-mid">Docs</a>
          <a
            href={repoUrl}
            target="_blank"
            rel="noreferrer"
            class="flex items-center gap-2 transition-colors hover:text-brand-mid"
          >
            <Icon name="github" class="h-4 w-4" />
            GitHub
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>

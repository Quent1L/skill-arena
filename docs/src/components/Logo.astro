---
/**
 * The Skol Arena lockup. Static counterpart of the app's SkolLogo component —
 * the docs site is its own package, so the geometry is restated here rather than
 * imported across workspaces.
 *
 * The height follows the artwork's ratio: pass a width and leave it alone.
 */
interface Props {
  width?: number
  class?: string
}

const { width = 360, class: className } = Astro.props

// Mirrors the app's logo-paths.ts. The mark is drawn at 0.78 inside the lockup:
// at native size it stands half again as tall as the SKOL + ARENA block and reads
// as an icon with a caption rather than as one lockup.
const VIEW_BOX = '50.5688 29.8935 364.2412 129.2730'
const RATIO = 364.2412 / 129.273
const MARK_TRANSFORM = 'translate(28.8398,22.7505) scale(0.78)'
const height = Math.round(width / RATIO)

// Gradient ids share one document-wide namespace, and this component renders
// twice on the home page. A per-instance prefix keeps the two from colliding;
// it is baked into the static output at build time.
const uid = `sk-${crypto.randomUUID().slice(0, 8)}`
---

<svg
  width={width}
  height={height}
  viewBox={VIEW_BOX}
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Skol Arena"
  class={className}
>
  <defs>
    <linearGradient
      id={`${uid}-mark`}
      gradientUnits="userSpaceOnUse"
      x1="0"
      y1="19"
      x2="0"
      y2="165"
    >
      <stop offset="0" stop-color="#DC9FFC"></stop>
      <stop offset="0.25" stop-color="#B871FA"></stop>
      <stop offset="0.45" stop-color="#9044F5"></stop>
      <stop offset="0.65" stop-color="#6522D9"></stop>
      <stop offset="1" stop-color="#551DC8"></stop>
    </linearGradient>
    <linearGradient
      id={`${uid}-skol`}
      gradientUnits="userSpaceOnUse"
      x1="0"
      y1="49"
      x2="0"
      y2="107"
    >
      <stop offset="0" stop-color="#FBFBFB"></stop>
      <stop offset="1" stop-color="#F5F6F8"></stop>
    </linearGradient>
    <linearGradient
      id={`${uid}-arena`}
      gradientUnits="userSpaceOnUse"
      x1="0"
      y1="127"
      x2="0"
      y2="140"
    >
      <stop offset="0" stop-color="#853CE4"></stop>
      <stop offset="0.375" stop-color="#883AF6"></stop>
      <stop offset="1" stop-color="#8030EE"></stop>
    </linearGradient>
    <linearGradient
      id={`${uid}-lineL`}
      gradientUnits="userSpaceOnUse"
      x1="160"
      y1="0"
      x2="202"
      y2="0"
    >
      <stop offset="0" stop-color="#1A1246" stop-opacity="0.11"></stop>
      <stop offset="0.5" stop-color="#8C41C9" stop-opacity="0.95"></stop>
      <stop offset="0.75" stop-color="#904AE4" stop-opacity="1"></stop>
      <stop offset="1" stop-color="#E467FF" stop-opacity="0.58"></stop>
    </linearGradient>
    <linearGradient
      id={`${uid}-lineR`}
      gradientUnits="userSpaceOnUse"
      x1="366"
      y1="0"
      x2="409"
      y2="0"
    >
      <stop offset="0" stop-color="#5B1A87" stop-opacity="0.51"></stop>
      <stop offset="0.125" stop-color="#9A57ED" stop-opacity="1"></stop>
      <stop offset="0.5" stop-color="#823DC5" stop-opacity="0.89"></stop>
      <stop offset="1" stop-color="#1C1242" stop-opacity="0.1"></stop>
    </linearGradient>
  </defs>

  <g transform={MARK_TRANSFORM}>
    <path
      fill={`url(#${uid}-mark)`}

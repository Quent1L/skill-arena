---
interface Props {
  title: string
  subtitle?: string
  eyebrow?: string
  align?: 'center' | 'left'
  class?: string
}
const { title, subtitle, eyebrow, align = 'center', class: className = '' } = Astro.props

const alignment = align === 'center' ? 'mx-auto max-w-2xl text-center' : 'max-w-3xl'
---

<div class={`${alignment} ${className}`}>
  {
    eyebrow && (
      <p class="mb-3 text-xs font-semibold tracking-[0.2em] text-brand-mid uppercase">{eyebrow}</p>
    )
  }
  <h2 class="text-2xl font-bold text-balance text-white sm:text-3xl">{title}</h2>
  {subtitle && <p class="mt-3 text-slate-400">{subtitle}</p>}
</div>

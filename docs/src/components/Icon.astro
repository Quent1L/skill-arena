  'arrow-right': 'M5 12h14m0 0-6-6m6 6-6 6',
}

// Brand marks are solid shapes, not line drawings — stroking them looks wrong
const filled = new Set(['github'])
const isFilled = filled.has(name)
---

<svg
  class={className}
  viewBox={isFilled ? '0 0 16 16' : '0 0 24 24'}
  fill={isFilled ? 'currentColor' : 'none'}
  stroke={isFilled ? 'none' : 'currentColor'}
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={icons[name] ?? icons.bolt}></path>
</svg>

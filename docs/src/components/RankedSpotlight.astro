---
import type { CollectionEntry } from 'astro:content'
import Icon from './Icon.astro'
import ScreenshotPlaceholder from './ScreenshotPlaceholder.astro'

interface Props {
  variant: 'home' | 'features'
  feature: CollectionEntry<'showcase'>
}
const { variant, feature } = Astro.props

const stats = [
  { icon: 'trophy', label: 'Elo-derivative MMR' },
  { icon: 'chart', label: '5 dynamic rank tiers' },
  { icon: 'bolt', label: 'Live provisional leaderboard' },
  { icon: 'layers', label: 'Per-discipline scoring modes' },
]
---

{
  variant === 'home' ? (
    <div class="card-glow rounded-2xl border border-brand-mid/30 bg-gradient-to-br from-brand-start/10 via-white/[0.03] to-brand-end/10 p-8 sm:p-10">
      <div class="flex flex-col items-center gap-4 text-center">
        <span class="flex items-center gap-1.5 rounded-full border border-amber-400/30 bg-amber-400/10 px-3 py-1 text-xs font-semibold tracking-wide text-amber-300 uppercase">
          <Icon name="trophy" class="h-3.5 w-3.5" />
          Flagship
        </span>
        <h2 class="text-2xl font-bold text-white sm:text-3xl">{feature.data.title}</h2>
        <p class="max-w-2xl text-slate-300">{feature.data.summary}</p>
        <div class="mt-2 flex flex-wrap items-center justify-center gap-3">
          {stats.map((stat) => (
            <span class="flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3.5 py-1.5 text-xs font-medium text-slate-300">
              <Icon name={stat.icon} class="h-3.5 w-3.5 text-brand-mid" />
              {stat.label}
            </span>
          ))}
        </div>
        <a
          href="/features#ranked-mode"
          class="mt-2 flex items-center gap-2 rounded-full bg-gradient-to-r from-brand-start to-brand-end px-6 py-3 font-semibold text-white shadow-lg shadow-brand-start/30 transition-transform hover:scale-105"
        >
          See how ranked works
        </a>
      </div>
    </div>
  ) : (
    <article
      id="ranked-mode"
      class="scroll-mt-24 rounded-2xl border border-brand-mid/30 bg-gradient-to-br from-brand-start/10 via-white/[0.03] to-brand-end/10 p-8"
    >
      <div class="mb-6 flex flex-wrap items-center gap-3">
        <span class="flex items-center gap-1.5 rounded-full border border-amber-400/30 bg-amber-400/10 px-3 py-1 text-xs font-semibold tracking-wide text-amber-300 uppercase">
          <Icon name="trophy" class="h-3.5 w-3.5" />
          Flagship
        </span>
        <h2 class="text-2xl font-bold text-white">{feature.data.title}</h2>
      </div>
      {feature.data.summary && (
        <p class="mb-6 max-w-3xl text-lg text-slate-300">{feature.data.summary}</p>
      )}
      <div class="mb-8 flex flex-wrap gap-3">
        {stats.map((stat) => (
          <span class="flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3.5 py-1.5 text-xs font-medium text-slate-300">
            <Icon name={stat.icon} class="h-3.5 w-3.5 text-brand-mid" />
            {stat.label}
          </span>
        ))}
      </div>
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
        <div class="prose prose-invert max-w-none text-slate-300 prose-headings:text-white prose-headings:font-semibold prose-a:text-brand-mid prose-a:no-underline hover:prose-a:underline prose-strong:text-slate-100 [&_p]:mb-3">
          <slot />
        </div>
        <ScreenshotPlaceholder caption="Ranked leaderboard screenshot" />
      </div>
      <p class="mt-8 text-sm text-slate-400">
        Ranked's MMR math is driven by each discipline's scoring rules — see the{' '}
        <a href="#disciplines-outcomes" class="text-brand-mid hover:text-brand-end">
          disciplines & outcomes
        </a>{' '}
        breakdown above.
      </p>
    </article>
  )
}

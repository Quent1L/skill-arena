---
import type { CollectionEntry } from 'astro:content'
import type { ImageMetadata } from 'astro'
import { getCollection, render } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import { softwareApplication } from '../lib/schema'
import Icon from '../components/Icon.astro'
import SectionHeading from '../components/SectionHeading.astro'
import FeatureCard from '../components/FeatureCard.astro'
import DeviceShot from '../components/DeviceShot.astro'
import RankedSpotlight from '../components/RankedSpotlight.astro'

import standingsDesktop from '../assets/screenshots/standings-desktop.png'
import standingsMobile from '../assets/screenshots/standings-mobile.png'
import bracketDesktop from '../assets/screenshots/bracket-desktop.png'
import bracketMobile from '../assets/screenshots/bracket-mobile.png'

type Pillar = 'championship' | 'bracket' | 'ranked' | 'platform'

const RANKED_ID = 'features/ranked-mode'

/**
 * Features that have a screen of their own. A feature missing from this map
 * simply renders full width: an empty frame saying "screenshot coming soon" is
 * worse than no frame at all.
 */
const SHOTS: Record<
  string,
  { desktop: ImageMetadata; mobile: ImageMetadata; alt: string; caption: string }
> = {
  'features/championship-limits': {
    desktop: standingsDesktop,
    mobile: standingsMobile,
    alt: 'Championship standings with points, matches played, wins, losses and score difference',
    caption: 'Standings, once the caps have been applied',
  },
  'features/bracket-seeding': {
    desktop: bracketDesktop,
    mobile: bracketMobile,
    alt: 'A single elimination bracket with quarter-finals and semi-finals played',
    caption: 'A bracket drawn from a finished season',
  },
}
const byOrder = (a: CollectionEntry<'showcase'>, b: CollectionEntry<'showcase'>) =>
  a.data.order - b.data.order

const features = (await getCollection('showcase', ({ id }) => id.startsWith('features/'))).sort(
  byOrder,
)
const modes = (await getCollection('showcase', ({ id }) => id.startsWith('modes/'))).sort(byOrder)

const slug = (id: string) => id.replace('features/', '')
const modeOf = (pillar: Pillar) => modes.find((mode) => mode.data.pillar === pillar)

const pillars: { id: Pillar; title: string; icon: string; subtitle: string }[] = [
  {
    id: 'championship',
    title: 'Championship',
    icon: 'flag',
    subtitle: 'Flexible competitions that run over days or weeks.',
  },
  {
    id: 'bracket',
    title: 'Bracket',
    icon: 'layers',
    subtitle: 'Elimination tournaments, playoffs, and final stages.',
  },
  {
    id: 'ranked',
    title: 'Ranked',
    icon: 'trophy',
    subtitle: 'A persistent MMR ladder for continuous competitive play.',
  },
  {
    id: 'platform',
    title: 'Across every mode',
    icon: 'sliders',
    subtitle: 'The capabilities every competition mode builds on.',
  },
]

const sections = await Promise.all(
  pillars.map(async (pillar) => {
    const mode = modeOf(pillar.id)
    const entries = features.filter((feature) => feature.data.pillar === pillar.id)
    return {
      ...pillar,
      ModeContent: mode ? (await render(mode)).Content : null,
      entries: await Promise.all(
        entries.map(async (feature) => ({ feature, Content: (await render(feature)).Content })),
      ),
    }
  }),
)
---

<BaseLayout
  title="Features"
  description="Championship, Bracket, and Ranked — and everything the three modes build on."
  jsonLd={[softwareApplication(Astro.site)]}
>
  <section class="relative overflow-hidden">
    <div class="bg-grid pointer-events-none absolute inset-0"></div>
    <div class="relative mx-auto max-w-3xl px-6 py-16 text-center">
      <h1 class="animate-fade-up text-3xl font-extrabold text-white sm:text-4xl">
        <span class="text-gradient">Features</span>
      </h1>
      <p class="animate-fade-up mt-4 text-slate-400" style="animation-delay: 0.05s">
        Three competition modes, and the player-driven platform underneath them.
      </p>

      <div
        class="animate-fade-up mt-8 flex flex-wrap justify-center gap-2"
        style="animation-delay: 0.1s"
      >
        {
          pillars.map((pillar) => (
            <a
              href={`#${pillar.id}`}
              class="flex items-center gap-1.5 rounded-full border border-white/10 bg-white/5 px-3.5 py-1.5 text-xs font-medium text-slate-300 transition-colors hover:border-brand-mid/50 hover:text-brand-mid"
            >
              <Icon name={pillar.icon} class="h-3.5 w-3.5" />
              {pillar.title}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <div class="mx-auto flex max-w-6xl flex-col gap-20 px-6 pb-24">
    {
      sections.map((section) => (
        <section id={section.id} class="scroll-mt-24">
          <SectionHeading eyebrow={section.title} title={section.subtitle} align="left" />
          {section.ModeContent && (
            <div class="prose prose-invert prose-strong:text-slate-100 mt-5 max-w-3xl text-slate-300">
              <section.ModeContent />
            </div>
          )}

          {section.id === 'platform' ? (
            <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
              {section.entries.map(({ feature, Content }) => (
                <FeatureCard
                  id={slug(feature.id)}
                  title={feature.data.title}
                  icon={feature.data.icon}
                  badge={feature.data.badge}
                  href={feature.data.docs}
                >
                  <Content />
                </FeatureCard>
              ))}
            </div>
          ) : (
            <div class="mt-8 flex flex-col gap-6">
              {section.entries.map(({ feature, Content }) => {
                if (feature.id === RANKED_ID) {
                  return (
                    <RankedSpotlight variant="features" feature={feature}>
                      <Content />
                    </RankedSpotlight>
                  )
                }

                return (
                  <article
                    id={slug(feature.id)}
                    class="grid scroll-mt-24 grid-cols-1 gap-10 rounded-2xl border border-white/10 bg-white/[0.03] p-8 md:grid-cols-5 lg:p-10"
                  >
                    <div class={SHOTS[feature.id] ? 'md:col-span-3' : 'md:col-span-5'}>
                      <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-start/15 text-brand-mid">
                        <Icon name={feature.data.icon ?? 'bolt'} class="h-6 w-6" />
                      </div>
                      <div class="mb-1 flex flex-wrap items-center gap-2">
                        <h3 class="text-2xl font-bold text-white">{feature.data.title}</h3>
                        {feature.data.badge && (
                          <span class="rounded-full border border-amber-400/30 bg-amber-400/10 px-2 py-0.5 text-[10px] font-semibold tracking-wide text-amber-300 uppercase">
                            {feature.data.badge}
                          </span>
                        )}
                      </div>
                      {feature.data.summary && (
                        <p class="text-sm font-medium text-brand-mid/80">{feature.data.summary}</p>
                      )}
                      <div class="prose prose-invert prose-headings:font-semibold prose-headings:text-white prose-a:text-brand-mid prose-a:no-underline hover:prose-a:underline prose-strong:text-slate-100 mt-4 max-w-none text-slate-300 [&_p]:mb-3">
                        <Content />
                      </div>
                    </div>
                    {SHOTS[feature.id] && (
                      <div class="md:col-span-2">
                        <div class="md:sticky md:top-24">
                          <DeviceShot {...SHOTS[feature.id]} />
                        </div>
                      </div>
                    )}
                  </article>
                )
              })}
            </div>
          )}
        </section>
      ))
    }
  </div>
</BaseLayout>

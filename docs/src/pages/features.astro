---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import Icon from '../components/Icon.astro'
import ScreenshotPlaceholder from '../components/ScreenshotPlaceholder.astro'
import RankedSpotlight from '../components/RankedSpotlight.astro'

const RANKED_ID = 'features/ranked-mode'
const allFeatures = await getCollection('showcase', ({ id }) => id.startsWith('features/'))
const features = allFeatures.sort((a, b) => a.data.order - b.data.order)

const slug = (id: string) => id.replace('features/', '')
---

<BaseLayout title="Features" description="Everything Skol Arena does, in one page.">
  <section class="relative overflow-hidden">
    <div class="bg-grid pointer-events-none absolute inset-0"></div>
    <div class="relative mx-auto max-w-3xl px-6 py-16 text-center">
      <h1 class="animate-fade-up text-3xl font-extrabold text-white sm:text-4xl">
        <span class="text-gradient">Features</span>
      </h1>
      <p class="animate-fade-up mt-4 text-slate-400" style="animation-delay: 0.05s">
        Everything you need to run a competitive community.
      </p>

      <div
        class="animate-fade-up mt-8 flex flex-wrap justify-center gap-2"
        style="animation-delay: 0.1s"
      >
        {
          features.map((feature) => (
            <a
              href={`#${slug(feature.id)}`}
              class="flex items-center gap-1.5 rounded-full border border-white/10 bg-white/5 px-3.5 py-1.5 text-xs font-medium text-slate-300 transition-colors hover:border-brand-mid/50 hover:text-brand-mid"
            >
              <Icon name={feature.data.icon ?? 'bolt'} class="h-3.5 w-3.5" />
              {feature.data.title}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto flex max-w-4xl flex-col gap-6 px-6 pb-24">
    {
      features.map(async (feature, i) => {
        const { Content } = await render(feature)
        const reversed = i % 2 === 1

        if (feature.id === RANKED_ID) {
          return (
            <RankedSpotlight variant="features" feature={feature}>
              <Content />
            </RankedSpotlight>
          )
        }

        return (
          <article
            id={slug(feature.id)}
            class="scroll-mt-24 grid grid-cols-1 items-center gap-8 rounded-2xl border border-white/10 bg-white/[0.03] p-8 md:grid-cols-2"
          >
            <div class={reversed ? 'md:order-2' : ''}>
              <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-start/15 text-brand-mid">
                <Icon name={feature.data.icon ?? 'bolt'} class="h-6 w-6" />
              </div>
              <div class="mb-1 flex items-center gap-2">
                <h2 class="text-2xl font-bold text-white">{feature.data.title}</h2>
                {feature.data.badge && (
                  <span class="rounded-full border border-amber-400/30 bg-amber-400/10 px-2 py-0.5 text-[10px] font-semibold tracking-wide text-amber-300 uppercase">
                    {feature.data.badge}
                  </span>
                )}
              </div>
              {feature.data.summary && (
                <p class="text-sm font-medium text-brand-mid/80">{feature.data.summary}</p>
              )}
              <div class="prose prose-invert max-w-none text-slate-300 prose-headings:font-semibold prose-headings:text-white prose-a:text-brand-mid prose-a:no-underline hover:prose-a:underline prose-strong:text-slate-100 mt-4 [&_p]:mb-3">
                <Content />
              </div>
            </div>
            <div class={reversed ? 'md:order-1' : ''}>
              <ScreenshotPlaceholder caption={`${feature.data.title} screenshot`} />
            </div>
          </article>
        )
      })
    }
  </section>
</BaseLayout>

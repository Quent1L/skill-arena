---
import { readFileSync } from 'node:fs'
import { resolve } from 'node:path'
import { getEntry, getCollection, render } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import Logo from '../components/Logo.astro'
import Icon from '../components/Icon.astro'
import SectionHeading from '../components/SectionHeading.astro'
import FeatureCard from '../components/FeatureCard.astro'
import ModeCard from '../components/ModeCard.astro'
import FaqAccordion from '../components/FaqAccordion.astro'
import ScreenshotPlaceholder from '../components/ScreenshotPlaceholder.astro'

const entry = async (id: string) => {
  const found = await getEntry('showcase', id)
  if (!found) throw new Error(`Missing showcase/${id}.md content entry`)
  return { data: found.data, Content: (await render(found)).Content }
}

const hero = await entry('hero')
const why = await entry('why-home')
const players = await entry('players')

const modes = (await getCollection('showcase', ({ id }) => id.startsWith('modes/'))).sort(
  (a, b) => a.data.order - b.data.order,
)
const modeBodies = await Promise.all(
  modes.map(async (mode) => ({ mode, Content: (await render(mode)).Content })),
)

const faq = (await getCollection('showcase', ({ id }) => id.startsWith('faq/'))).sort(
  (a, b) => a.data.order - b.data.order,
)

// The version shown in the hero badge comes from the monorepo root package.json,
// which release-it bumps — never hardcode it here. Astro runs with the docs/
// workspace as cwd, so the root manifest sits one level up.
const rootPackage = resolve(process.cwd(), '../package.json')
const { version } = JSON.parse(readFileSync(rootPackage, 'utf-8')) as { version: string }

const differentiators = [
  {
    title: 'Brackets seeded from your season',
    body: 'A final bracket can be drawn at random or seeded straight from a finished championship’s standings, so the season you just played decides the matchups.',
  },
  {
    title: 'Mobile-first for real-world play',
    body: 'Dedicated mobile screens — not a shrunken desktop layout — plus an installable PWA. Report a result or check standings from the venue in seconds.',
  },
  {
    title: 'Championships that fit real schedules',
    body: 'No obligation for everyone to play everyone. Cap match volume, run the season over weeks, and let availability decide who plays who.',
  },
  {
    title: 'Guardrails that keep standings credible',
    body: 'Per-tournament validation modes, a trust score that resets on dispute, and championship caps on matches per player, repeat opponents, and repeat partners.',
  },
  {
    title: 'Match formats beyond 1v1',
    body: 'Solo play, static rosters that stay together all season, or flex teams grouped per match — with configurable minimum and maximum team sizes.',
  },
  {
    title: 'Scoring rules that follow your discipline',
    body: 'Define the games you play once, then set their outcome types, point weights, and MMR multipliers. A forfeit does not have to move anyone’s rating.',
  },
]

const audiences = [
  {
    icon: 'trophy',
    title: 'Clubs and associations',
    desc: 'Run championships, ranked play, and final brackets without forcing members into rigid schedules or admin-heavy workflows.',
  },
  {
    icon: 'building',
    title: 'Workplaces',
    desc: 'Colleagues play when they are available, report results themselves, and the competition keeps going without constant organizer involvement.',
  },
  {
    icon: 'chat',
    title: 'Bars and local venues',
    desc: 'Recurring competitions that are simple to manage, easy to use on a phone, and engaging enough to bring people back.',
  },
  {
    icon: 'compass',
    title: 'Independent organizers',
    desc: 'Go beyond generic brackets with configurable disciplines, flexible structures, and player-driven workflows.',
  },
]
---

<BaseLayout title="Home">
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div
      class="animate-float pointer-events-none absolute top-[-10rem] left-1/2 h-[36rem] w-[36rem] -translate-x-1/2 rounded-full bg-brand-start/25 blur-3xl"
    >
    </div>
    <div
      class="pointer-events-none absolute top-10 right-[-6rem] h-72 w-72 rounded-full bg-brand-end/20 blur-3xl"
    >
    </div>
    <div class="bg-grid pointer-events-none absolute inset-0"></div>

    <div class="relative mx-auto flex max-w-3xl flex-col items-center gap-6 px-6 py-20 text-center">
      <div class="animate-fade-up">
        <Logo width={280} />
      </div>
      <span
        class="animate-fade-up flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-xs font-medium text-slate-300"
        style="animation-delay: 0.05s"
      >
        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400"></span>
        Open source · Self-hostable · v{version}
      </span>
      <h1
        class="animate-fade-up text-4xl leading-tight font-extrabold text-balance sm:text-5xl"
        style="animation-delay: 0.1s"
      >
        <span class="text-gradient">{hero.data.title}</span>
      </h1>
      <div
        class="animate-fade-up max-w-none text-lg leading-relaxed text-slate-300 [&_p]:mb-4"
        style="animation-delay: 0.15s"
      >
        <hero.Content />
      </div>
      <div
        class="animate-fade-up flex flex-wrap items-center justify-center gap-3"
        style="animation-delay: 0.2s"
      >
        <a
          href="/docs"
          class="rounded-full bg-gradient-to-r from-brand-start to-brand-end px-6 py-3 font-semibold text-white shadow-lg shadow-brand-start/30 transition-transform hover:scale-105"
        >
          Get started
        </a>
        <a
          href="/features"
          class="rounded-full border border-white/15 px-6 py-3 font-semibold text-slate-100 transition-colors hover:border-brand-mid/60 hover:text-brand-mid"
        >
          See how it works
        </a>
      </div>

      <div class="animate-fade-up w-full pt-6" style="animation-delay: 0.25s">
        <ScreenshotPlaceholder caption="Dashboard preview" />
      </div>
    </div>
  </section>

  <!-- Why this exists -->
  <section class="relative mx-auto max-w-3xl px-6 pb-24">
    <SectionHeading eyebrow="Why this product exists" title={why.data.title} />
    <div
      class="prose prose-invert prose-lg prose-strong:text-slate-100 mx-auto mt-8 max-w-none text-slate-300"
    >
      <why.Content />
    </div>
  </section>

  <!-- Built for players -->
  <section class="relative border-y border-white/10 bg-black/20">
    <div class="mx-auto max-w-5xl px-6 py-20">
      <SectionHeading eyebrow="Built for players" title={players.data.title} />
      <div
        class="prose prose-invert prose-strong:text-slate-100 mx-auto mt-8 max-w-2xl text-center text-slate-300"
      >
        <players.Content />
      </div>
      <div class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2">
        <FeatureCard title="Report their own results" icon="check">
          <p>
            Any player in a match can create it and report the score — no admin step, no
            pre-generated schedule to wait for.
          </p>
        </FeatureCard>
        <FeatureCard title="Confirm, contest, or cancel" icon="repeat">
          <p>
            The opposing side confirms to finalize early, contests with a corrected score, or
            cancels a match that should not count.
          </p>
        </FeatureCard>
        <FeatureCard title="Follow it all on mobile" icon="phone">
          <p>
            Standings, match history, and rank progression on dedicated mobile screens, installable
            as an app on the home screen.
          </p>
        </FeatureCard>
        <FeatureCard title="Admin controls when you need them" icon="shield">
          <p>
            Tournament admins and delegated co-admins can edit, finalize, or delete any match — the
            competition just does not stall waiting on them.
          </p>
        </FeatureCard>
      </div>
    </div>
  </section>

  <!-- Three modes -->
  <section class="relative mx-auto max-w-6xl px-6 py-24">
    <SectionHeading
      eyebrow="Three ways to compete"
      title="Choose the competition mode that fits your community"
      subtitle="Championship, Bracket, and Ranked are independent modes — use one, or all three."
    />
    <div class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-3">
      {
        modeBodies.map(({ mode, Content }) => (
          <ModeCard entry={mode} href={`/features#${mode.data.pillar}`}>
            <Content />
          </ModeCard>
        ))
      }
    </div>
  </section>

  <!-- What makes it different -->
  <section class="relative border-y border-white/10 bg-black/20">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <SectionHeading
        eyebrow="What makes it different"
        title="Built for communities that need more than a standard tournament tool"
      />
      <div class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          differentiators.map((item, i) => (
            <FeatureCard title={item.title} number={i + 1}>
              <p>{item.body}</p>
            </FeatureCard>
          ))
        }
      </div>
      <div class="mt-10 text-center">
        <a href="/features" class="text-sm font-semibold text-brand-mid hover:text-brand-end">
          See all features →
        </a>
      </div>
    </div>
  </section>

  <!-- Audiences -->
  <section class="relative mx-auto max-w-6xl px-6 py-24">
    <SectionHeading
      eyebrow="Who it's for"
      title="Designed for clubs, communities, and organizations that need flexibility"
    />
    <div class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2">
      {
        audiences.map((item) => (
          <div class="card-glow flex items-start gap-4 rounded-2xl border border-white/10 bg-white/[0.03] p-6">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-brand-start/15 text-brand-mid">
              <Icon name={item.icon} class="h-5 w-5" />
            </span>
            <div>
              <p class="font-semibold text-white">{item.title}</p>
              <p class="mt-1 text-sm leading-relaxed text-slate-400">{item.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- FAQ -->
  <section class="relative border-y border-white/10 bg-black/20">
    <div class="mx-auto max-w-3xl px-6 py-24">
      <SectionHeading eyebrow="FAQ" title="Questions people ask first" />
      <div class="mt-10">
        <FaqAccordion items={faq} />
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="relative border-t border-white/10 bg-black/20">
    <div class="mx-auto flex max-w-3xl flex-col items-center gap-5 px-6 py-16 text-center">
      <h2 class="text-2xl font-bold text-balance text-white sm:text-3xl">
        Run competitions the way your community actually plays
      </h2>
      <p class="text-slate-400">
        Flexible championships, elimination brackets, and player-driven ranked play — self-hosted
        with a single Docker container and your own PostgreSQL database.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a
          href="/docs"
          class="rounded-full bg-gradient-to-r from-brand-start to-brand-end px-6 py-3 font-semibold text-white shadow-lg shadow-brand-start/30 transition-transform hover:scale-105"
        >
          Start building your competition
        </a>
        <a
          href="https://github.com/Quent1L/skol-arena"
          target="_blank"
          rel="noreferrer"
          class="flex items-center gap-2 rounded-full border border-white/15 px-6 py-3 font-semibold text-slate-100 transition-colors hover:border-brand-mid/60 hover:text-brand-mid"
        >
          <Icon name="github" class="h-5 w-5" />
          View on GitHub
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

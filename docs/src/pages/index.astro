---
import { readFileSync } from 'node:fs'
import { resolve } from 'node:path'
import { getEntry, getCollection, render } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import { faqPage, softwareApplication } from '../lib/schema'
import Icon from '../components/Icon.astro'
import SectionHeading from '../components/SectionHeading.astro'
import FaqAccordion from '../components/FaqAccordion.astro'
import DeviceShot from '../components/DeviceShot.astro'

import tournamentsDesktop from '../assets/screenshots/tournaments-desktop.png'
import tournamentsMobile from '../assets/screenshots/tournaments-mobile.png'
import standingsDesktop from '../assets/screenshots/standings-desktop.png'
import standingsMobile from '../assets/screenshots/standings-mobile.png'
import bracketDesktop from '../assets/screenshots/bracket-desktop.png'
import bracketMobile from '../assets/screenshots/bracket-mobile.png'
import rankedDesktop from '../assets/screenshots/ranked-desktop.png'
import rankedMobile from '../assets/screenshots/ranked-mobile.png'
import matchDesktop from '../assets/screenshots/match-desktop.png'
import matchMobile from '../assets/screenshots/match-mobile.png'
import playerDesktop from '../assets/screenshots/player-desktop.png'
import playerMobile from '../assets/screenshots/player-mobile.png'

const entry = async (id: string) => {
  const found = await getEntry('showcase', id)
  if (!found) throw new Error(`Missing showcase/${id}.md content entry`)
  return { data: found.data, Content: (await render(found)).Content }
}

const hero = await entry('hero')
const why = await entry('why-home')
const players = await entry('players')
const championship = await entry('modes/championship')
const bracket = await entry('modes/bracket')
const ranked = await entry('modes/ranked')

const faq = (await getCollection('showcase', ({ id }) => id.startsWith('faq/'))).sort(
  (a, b) => a.data.order - b.data.order,
)

// The version shown on the page comes from the monorepo root package.json,
// which release-it bumps — never hardcode it here. Astro runs with the docs/
// workspace as cwd, so the root manifest sits one level up.
const rootPackage = resolve(process.cwd(), '../package.json')
const { version } = JSON.parse(readFileSync(rootPackage, 'utf-8')) as { version: string }

const facts = [
  { value: `v${version}`, label: 'Current release' },
  { value: 'AGPL-3.0', label: 'Open source' },
  { value: 'Self hostable', label: 'Docker compatible' },
  { value: 'Three modes', label: 'Use one, or all of them' },
]

const playerActions = [
  {
    icon: 'check',
    title: 'Report their own results',
    body: 'Any player in a match can create it and report the score. No admin step, no pre-generated schedule to wait for.',
  },
  {
    icon: 'repeat',
    title: 'Confirm, contest, or cancel',
    body: 'The opposing side confirms to finalize early, contests with a corrected score, or cancels a match that should not count.',
  },
  {
    icon: 'shield',
    title: 'Admin controls when you need them',
    body: 'Tournament admins and delegated co-admins can edit, finalize, or delete any match. The competition just does not stall waiting on them.',
  },
]

const differentiators = [
  {
    title: 'Brackets seeded from your season',
    body: 'A final bracket can be drawn at random or seeded straight from a finished championship’s standings, so the season you just played decides the matchups.',
  },
  {
    title: 'Mobile-first for real-world play',
    body: 'Dedicated mobile screens, not a shrunken desktop layout, plus an installable PWA. Report a result or check standings from the venue in seconds.',
  },
  {
    title: 'Championships that fit real schedules',
    body: 'No obligation for everyone to play everyone. Cap match volume, run the season over weeks, and let availability decide who plays who.',
  },
  {
    title: 'Guardrails that keep standings credible',
    body: 'Per-tournament validation modes, a trust score that resets on dispute, and championship caps on matches per player, repeat opponents, and repeat partners.',
  },
  {
    title: 'Match formats beyond 1v1',
    body: 'Solo play, static rosters that stay together all season, or flex teams grouped per match, with configurable minimum and maximum team sizes.',
  },
  {
    title: 'Scoring rules that follow your discipline',
    body: 'Define the games you play once, then set their outcome types, point weights, and MMR multipliers. A forfeit does not have to move anyone’s rating.',
  },
]

const audiences = [
  {
    icon: 'trophy',
    title: 'Clubs and associations',
    desc: 'Championships, ranked play, and final brackets without rigid schedules or admin-heavy workflows.',
  },
  {
    icon: 'building',
    title: 'Workplaces',
    desc: 'Colleagues play when they are available and report results themselves. The competition keeps going.',
  },
  {
    icon: 'chat',
    title: 'Bars and local venues',
    desc: 'Recurring competitions that are simple to manage, easy on a phone, and worth coming back for.',
  },
  {
    icon: 'compass',
    title: 'Independent organizers',
    desc: 'Configurable disciplines, flexible structures, and player-driven workflows beyond a generic bracket.',
  },
]
---

<BaseLayout
  description="Open-source, self-hostable tournament software. Run championship leagues, elimination brackets and ranked ladders with per-discipline MMR — players report their own matches."
  jsonLd={[softwareApplication(Astro.site), faqPage(faq, Astro.site, Astro.url.pathname)]}
>
  <!-- Hero: message on the left, the actual product on the right -->
  <section class="relative overflow-hidden border-b border-white/10">
    <div class="bg-grid pointer-events-none absolute inset-0"></div>
    <div
      class="relative mx-auto grid max-w-6xl items-center gap-12 px-6 pt-16 pb-20 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-16 lg:pt-24"
    >
      <div class="animate-fade-up">
        <h1 class="text-4xl leading-[1.08] font-extrabold text-balance text-white sm:text-5xl">
          {hero.data.title}
        </h1>
        <div class="mt-6 max-w-[46ch] text-lg leading-relaxed text-slate-300 [&_p]:mb-0">
          <hero.Content />
        </div>
        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a
            href="/docs"
            class="rounded-full bg-brand-start px-6 py-3 font-semibold text-white transition-colors hover:bg-brand-start/85"
          >
            Get started
          </a>
          <a
            href="https://github.com/Quent1L/skol-arena"
            target="_blank"
            rel="noreferrer"
            class="flex items-center gap-2 rounded-full border border-white/15 px-6 py-3 font-semibold text-slate-100 transition-colors hover:border-brand-mid/60 hover:text-brand-mid"
          >
            <Icon name="github" class="h-5 w-5" />
            View the source
          </a>
        </div>
      </div>

      <DeviceShot
        class="animate-fade-up"
        desktop={tournamentsDesktop}
        mobile={tournamentsMobile}
        alt="The Skol Arena home screen listing a player's ongoing competitions"
        caption="Every competition a player is in, in one place"
        width={320}
        eager
      />
    </div>
  </section>

  <!-- Facts: what you are actually getting, before any argument -->
  <section class="border-b border-white/10 bg-black/20">
    <div class="mx-auto grid max-w-6xl grid-cols-2 px-6 lg:grid-cols-4">
      {
        facts.map((fact) => (
          <div class="border-l border-white/10 px-2 py-8 first:border-l-0 lg:px-6">
            <p class="font-display text-2xl font-bold text-white">{fact.value}</p>
            <p class="mt-1 text-sm text-slate-400">{fact.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Why it exists: the argument, next to a season's worth of history -->
  <section class="relative mx-auto max-w-6xl px-6 py-24">
    <div class="reveal grid items-center gap-12 lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)]">
      <div>
        <SectionHeading align="left" title={why.data.title} />
        <div
          class="prose prose-invert prose-lg prose-strong:text-slate-100 mt-6 max-w-[62ch] text-slate-300"
        >
          <why.Content />
        </div>
      </div>
      <DeviceShot
        desktop={playerDesktop}
        mobile={playerMobile}
        alt="A player profile showing ranked career, per-tournament records and toughest opponents"
        caption="A player's record, across every season"
      />
    </div>
  </section>

  <!-- Ranked: the flagship mode, given its own section -->
  <section class="border-y border-white/10 bg-black/20">
    <div
      class="reveal mx-auto grid max-w-6xl items-center gap-12 px-6 py-20 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:gap-16"
    >
      <DeviceShot
        desktop={rankedDesktop}
        mobile={rankedMobile}
        alt="A ranked leaderboard grouped into Diamond, Platinum, Gold and Silver tiers"
        caption="Rank tiers that follow the player pool, not fixed bands"
      />
      <div>
        <p class="font-display text-3xl font-bold text-white">{ranked.data.title}</p>
        <p class="mt-2 text-brand-mid">{ranked.data.tagline}</p>
        <div
          class="prose prose-invert prose-strong:text-slate-100 mt-6 max-w-[58ch] text-slate-300 [&_p]:mb-4"
        >
          <ranked.Content />
        </div>
        {
          ranked.data.bestFor && (
            <ul class="mt-8 flex flex-wrap gap-2">
              {ranked.data.bestFor.map((item) => (
                <li class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-1.5 text-sm text-slate-300">
                  {item}
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
  </section>

  <!-- The other two modes, each with the screen it is really about -->
  <section class="mx-auto max-w-6xl px-6 py-24">
    <SectionHeading
      align="left"
      title="Two more ways to compete, independent of each other"
      subtitle="Run a season that stretches over weeks, a bracket for a one-night event, or both alongside the ladder."
    />
    <div class="reveal mt-12 grid gap-6 lg:grid-cols-2">
      {
        [
          {
            entry: championship,
            desktop: standingsDesktop,
            mobile: standingsMobile,
            alt: 'Championship standings with points, matches played, wins, losses and score difference',
          },
          {
            entry: bracket,
            desktop: bracketDesktop,
            mobile: bracketMobile,
            alt: 'A single elimination bracket with quarter-finals and semi-finals played',
          },
        ].map(({ entry: mode, desktop, mobile, alt }) => (
          <article class="flex flex-col rounded-2xl border border-white/10 bg-white/[0.03] p-6">
            <DeviceShot desktop={desktop} mobile={mobile} alt={alt} width={260} />
            <p class="font-display mt-8 text-2xl font-bold text-white">{mode.data.title}</p>
            <p class="mt-1 text-sm text-brand-mid">{mode.data.tagline}</p>
            <div class="prose prose-invert prose-sm prose-strong:text-slate-200 mt-4 max-w-none text-slate-400 [&_p]:mb-3">
              <mode.Content />
            </div>
            {mode.data.bestFor && (
              <ul class="mt-auto flex flex-wrap gap-2 pt-6">
                {mode.data.bestFor.map((item) => (
                  <li class="rounded-full border border-white/10 px-3 py-1 text-xs text-slate-400">
                    {item}
                  </li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </div>
    <p class="mt-8">
      <a href="/features" class="text-sm font-semibold text-brand-mid hover:text-brand-end">
        See every feature →
      </a>
    </p>
  </section>

  <!-- Players run the day to day -->
  <section class="border-y border-white/10 bg-black/20">
    <div
      class="reveal mx-auto grid max-w-6xl items-center gap-12 px-6 py-20 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:gap-16"
    >
      <DeviceShot
        class="lg:order-last"
        desktop={matchDesktop}
        mobile={matchMobile}
        alt="A reported match waiting for the opponent to accept or dispute the score"
        caption="The opponent accepts or disputes, straight from the match"
      />
      <div>
        <SectionHeading align="left" title={players.data.title} />
        <div
          class="prose prose-invert prose-strong:text-slate-100 mt-6 max-w-[58ch] text-slate-300"
        >
          <players.Content />
        </div>
        <ul class="mt-8 divide-y divide-white/10 border-t border-white/10">
          {
            playerActions.map((action) => (
              <li class="flex gap-4 py-5">
                <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-start/15 text-brand-mid">
                  <Icon name={action.icon} class="h-4 w-4" />
                </span>
                <div>
                  <p class="font-semibold text-white">{action.title}</p>
                  <p class="mt-1 text-sm leading-relaxed text-slate-400">{action.body}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- What sets it apart, as a reference list rather than another card grid -->
  <section class="mx-auto max-w-6xl px-6 py-24">
    <SectionHeading
      align="left"
      title="Built for communities that need more than a standard tournament tool"
    />
    <ol class="reveal mt-12 grid gap-x-16 border-t border-white/10 sm:grid-cols-2">
      {
        differentiators.map((item, i) => (
          <li class="flex gap-5 border-b border-white/10 py-7">
            <span class="font-display w-6 shrink-0 text-lg font-bold text-brand-mid tabular-nums">
              {i + 1}
            </span>
            <div>
              <p class="font-semibold text-white">{item.title}</p>
              <p class="mt-1.5 text-sm leading-relaxed text-slate-400">{item.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Who runs it -->
  <section class="border-y border-white/10 bg-black/20">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <SectionHeading align="left" title="Who it is for" />
      <div class="reveal mt-10 grid gap-x-12 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          audiences.map((item) => (
            <div class="border-t border-white/10 pt-6">
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-start/15 text-brand-mid">
                <Icon name={item.icon} class="h-5 w-5" />
              </span>
              <p class="mt-4 font-semibold text-white">{item.title}</p>
              <p class="mt-1.5 text-sm leading-relaxed text-slate-400">{item.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="mx-auto max-w-3xl px-6 py-24">
    <SectionHeading align="left" title="Questions people ask first" />
    <div class="mt-10">
      <FaqAccordion items={faq} />
    </div>
  </section>

  <!-- Final CTA -->
  <section class="border-t border-white/10 bg-black/20">
    <div class="mx-auto max-w-3xl px-6 py-20 text-center">
      <h2 class="font-display text-2xl font-bold text-balance text-white sm:text-3xl">
        Run competitions the way your community actually plays
      </h2>
      <p class="mx-auto mt-4 max-w-[52ch] text-slate-400">
        Self-hosted on a single container next to your own PostgreSQL database.
      </p>
      <div
        class="mx-auto mt-8 w-fit rounded-2xl border border-white/10 bg-slate-950/70 px-5 py-3 text-left"
      >
        <code class="font-mono text-sm text-slate-300">
          docker pull quent1l/skol-arena:latest
        </code>
      </div>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/docs/deployment"
          class="rounded-full bg-brand-start px-6 py-3 font-semibold text-white transition-colors hover:bg-brand-start/85"
        >
          Get started
        </a>
        <a
          href="/docs"
          class="rounded-full border border-white/15 px-6 py-3 font-semibold text-slate-100 transition-colors hover:border-brand-mid/60 hover:text-brand-mid"
        >
          Read the docs
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

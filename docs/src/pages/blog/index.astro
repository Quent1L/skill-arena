---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getPosts, formatDate } from '../../lib/posts'

const posts = await getPosts()
---

<BaseLayout
  title="Blog"
  description="Release notes and announcements from Skol Arena, written for the people who use it."
>
  <section class="relative overflow-hidden">
    <div class="bg-grid pointer-events-none absolute inset-0"></div>
    <div class="relative mx-auto max-w-3xl px-6 py-16 text-center">
      <h1 class="animate-fade-up text-3xl font-extrabold text-white sm:text-4xl">
        <span class="text-gradient">Blog</span>
      </h1>
      <p class="animate-fade-up mt-4 text-slate-400" style="animation-delay: 0.05s">
        What changed, and what it means for the people running and playing competitions.
      </p>
    </div>
  </section>

  <section class="relative mx-auto max-w-3xl px-6 pb-24">
    <div class="flex flex-col gap-5">
      {
        posts.map((post) => (
          <a
            href={`/blog/${post.id}`}
            class="card-glow group block rounded-2xl border border-white/10 bg-white/[0.03] p-6 transition-colors hover:bg-white/[0.05]"
          >
            <div class="flex flex-wrap items-center gap-2">
              {post.data.tag && (
                <span class="rounded-full border border-brand-mid/30 bg-brand-start/15 px-3 py-1 text-xs font-semibold tracking-wider text-brand-mid uppercase">
                  {post.data.tag}
                </span>
              )}
              {post.data.version && (
                <span class="rounded-full border border-white/15 bg-white/5 px-3 py-1 text-xs font-semibold text-slate-300">
                  v{post.data.version}
                </span>
              )}
              <time datetime={post.data.date.toISOString()} class="text-sm text-slate-400">
                {formatDate(post.data.date)}
              </time>
              {post.data.draft && (
                <span class="rounded-full border border-amber-400/30 bg-amber-400/10 px-2 py-0.5 text-[10px] font-semibold tracking-wide text-amber-300 uppercase">
                  Draft
                </span>
              )}
            </div>
            <h2 class="mt-3 text-xl font-semibold text-white transition-colors group-hover:text-brand-mid">
              {post.data.title}
            </h2>
            <p class="mt-2 leading-relaxed text-slate-400">{post.data.description}</p>
            <span class="mt-4 inline-block text-sm font-semibold text-brand-mid transition-colors group-hover:text-brand-end">
              Read more →
            </span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

# Packages already-built artifacts (backend/dist, frontend/dist) — no build stage.
# Requires `bun run build` to have run on the host first.
FROM oven/bun:1.3.14-slim AS production
WORKDIR /app

# --create-home matters: bun writes caches under $HOME and fails without it
RUN groupadd --system --gid 1001 skol && \
    useradd --system --uid 1001 --gid skol --create-home --shell /usr/sbin/nologin skol

COPY --chown=skol:skol backend/dist ./backend/dist
COPY --chown=skol:skol backend/drizzle ./backend/drizzle
COPY --chown=skol:skol frontend/dist ./frontend/dist

ENV NODE_ENV=production
ENV PORT=3000
ENV MIGRATIONS_FOLDER=./backend/drizzle
ENV FRONTEND_BUILD_PATH=/app/frontend/dist

EXPOSE 3000

USER skol

CMD ["bun", "./backend/dist/index.js"]

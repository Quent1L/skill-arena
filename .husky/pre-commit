# `bun test --isolate`, which the suite below is run with, only exists from the bun
# version pinned in the root package.json. An older bun accepts the flag and ignores
# it -- like any flag it does not know -- so the suite runs unisolated: mock.module
# calls leak across files and dozens of tests fail for reasons that have nothing to do
# with the commit. Bun does not enforce `engines` itself, so the floor is checked here.
bun -e '
  const required = require("./package.json").engines.bun;
  if (Bun.semver.satisfies(Bun.version, required)) process.exit(0);
  console.error(`\nbun ${Bun.version} is too old: this repo needs bun ${required}.`);
  console.error("Below it, `bun test --isolate` is silently a no-op and the suite fails on its own leakage.");
  console.error("Upgrade with: bun upgrade\n");
  process.exit(1);
' || exit 1

# The docs/ workspace is the Astro documentation site. It imports nothing from
# shared/backend/frontend and nothing imports it, so the application suite says
# nothing about a docs change — it just costs ~77s on every typo fix. Run the
# checks that do cover it instead (~9s), and keep the full suite for everything
# else.
#
# Anything outside docs/ in the same commit falls through to the full suite: the
# skip has to be provably safe, so an unrecognised path is never a reason to skip.
staged=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$staged" ]; then
  exit 0
fi

if printf '%s\n' "$staged" | grep -qvE '^docs/'; then
  bun run test:unit
else
  echo "Docs-only change — running docs checks, skipping the application suite."
  cd docs && bun run type-check && bun run lint
fi

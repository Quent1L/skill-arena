# --- Base ------------------------------------------------------
FROM oven/bun:1-alpine AS base
WORKDIR /app


# --- Dependencies ---------------------------------------------
FROM base AS deps

COPY package.json bun.lock ./
COPY shared/package.json ./shared/
COPY backend/package.json ./backend/
COPY frontend/package.json ./frontend/

RUN bun install --frozen-lockfile


# --- Build backend --------------------------------------------
FROM base AS build
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Build backend en JS bundlé (sans node_modules)
RUN bun build ./backend/src/index.ts \
    --target bun \
    --outdir ./backend/dist \
    --minify \
    --sourcemap=none \
    --loader .json:json


# --- Production ------------------------------------------------
FROM oven/bun:1-alpine AS production
WORKDIR /app

RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

COPY --from=build --chown=nodejs:nodejs /app/backend/dist ./backend/dist
COPY --from=build --chown=nodejs:nodejs /app/backend/drizzle ./backend/drizzle
# frontend/dist pré-buildé localement via `bun run build`
COPY --chown=nodejs:nodejs frontend/dist ./frontend/dist

ENV NODE_ENV=production
ENV PORT=3000
ENV MIGRATIONS_FOLDER=./backend/drizzle

EXPOSE 3000
USER nodejs
CMD ["bun", "./backend/dist/index.js"]

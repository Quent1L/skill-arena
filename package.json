{
  "name": "skill-arena-monorepo",
  "version": "1.12.2",
  "description": "Skol - Tournament Management Application",
  "private": true,
  "type": "module",
  "scripts": {
    "setup:db": "cd backend && bun run db:push",
    "dev": "bun run build:shared && concurrently \"bun run dev:shared\" \"bun run dev:backend\" \"bun run dev:frontend\" --names \"shared,backend,frontend\" --prefix-colors \"blue,green,yellow\"",
    "dev:shared": "cd shared && bun run dev",
    "dev:backend": "cd backend && bun run dev",
    "dev:frontend": "cd frontend && bun run dev",
    "build": "bun run build:shared && bun run build:frontend && bun run build:backend",
    "build:shared": "cd shared && bun run build",
    "build:frontend": "cd frontend && bun run build",
    "build:backend": "bun build ./backend/src/index.ts --target bun --outdir ./backend/dist --minify --sourcemap=none --loader .json:json",
    "type-check": "bun run type-check:shared && bun run type-check:backend && bun run type-check:frontend",
    "type-check:shared": "cd shared && bun run type-check",
    "type-check:backend": "cd backend && bun run type-check",
    "type-check:frontend": "cd frontend && bun run type-check",
    "test:unit": "bun run test:unit:backend && bun run test:unit:frontend",
    "test:unit:backend": "cd backend && bun run test",
    "test:unit:frontend": "cd frontend && bun run test:unit",
    "test:unit:cov": "bun run test:unit:cov:backend && bun run test:unit:cov:frontend",
    "test:unit:cov:backend": "cd backend && bun run test:cov",
    "test:unit:cov:frontend": "cd frontend && bun run test:unit:cov",
    "lint": "bun run lint:backend && bun run lint:shared && bun run lint:frontend",
    "lint:backend": "cd backend && bun run lint",
    "lint:shared": "cd shared && bun run lint",
    "lint:frontend": "cd frontend && bun run lint",
    "clean": "bun run clean:shared && bun run clean:frontend && bun run clean:backend",
    "clean:shared": "cd shared && rm -rf dist .tsbuildinfo",
    "clean:backend": "cd backend && rm -rf .tsbuildinfo dist",
    "clean:frontend": "cd frontend && rm -rf dist node_modules/.tmp",
    "release": "release-it",
    "release:dry": "release-it --dry-run",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@release-it/bumper": "^7.0.6",
    "@release-it/conventional-changelog": "^11.0.1",
    "concurrently": "^10.0.3",
    "husky": "^9.1.7",
    "release-it": "^20.2.0"
  },
  "workspaces": {
    "packages": [
      "shared",
      "backend",
      "frontend"
    ],
    "catalog": {
      "zod": "4.4.3",
      "better-auth": "1.6.14",
      "typescript": "6.0.3"
    }
  }
}

{
  "name": "backend",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "type-check": "tsc --noEmit",
    "build": "tsc --build",
    "db:generate": "bun run drizzle-kit generate",
    "db:push": "bun run drizzle-kit push",
    "job:auto-finalize": "bun run src/jobs/auto-finalize-matches.job.ts",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "bun test src/services/__tests__/*.test.ts --isolate",
    "test:cov": "bun test --isolate --coverage --coverage-reporter=text --coverage-reporter=lcov src/services/__tests__/*.test.ts src/services/__tests__/integration/*.test.ts",
    "test:integration": "bun test src/services/__tests__/integration/*.test.ts --isolate",
    "lint": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "@skill-arena/shared": "workspace:*",
    "better-auth": "catalog:",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "graphile-worker": "^0.16.6",
    "hono": "^4.12.15",
    "i18next": "^26.0.8",
    "i18next-http-middleware": "^3.9.6",
    "nodemailer": "^8.0.7",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "web-push": "^3.6.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.5",
    "@types/bun": "^1.3.13",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "prettier": "^3.8.0",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.0.0"
  }
}
